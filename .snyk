# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-SHARP-18184259:
    - '*':
        reason: >-
          sharp is a hard dep of @huggingface/transformers pinned to ^0.34.x
          (0.x caret blocks 0.35.0+, the only patched line). snyk reports
          isUpgradable:false/isPatchable:false. Dormant in our usage: image
          pipelines only, never the feature-extraction embeddings used here.
          Tracked upstream until a transformers release allows sharp ^0.35.
        expires: 2027-08-05T00:00:00.000Z
        created: 2026-08-05T08:16:58.018Z
