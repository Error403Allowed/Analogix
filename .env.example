# =============================================================================
# AnalogixWeb - Next.js runtime configuration
# Copy this file to `.env.local` and fill in the placeholders.
# NEVER commit your real `.env` or `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  (https://supabase.com/dashboard/project/_/settings/api)
# Public values baked into the client bundle (NEXT_PUBLIC_ prefix).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Service-role key (server-side only - never exposed to the client).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# -----------------------------------------------------------------------------
# Groq  (https://console.groq.com/keys)
# Optional secondary key for soft failover when rate-limited.
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
GROQ_API_KEY_2=gsk_REPLACE_WITH_OPTIONAL_SECONDARY_KEY

# -----------------------------------------------------------------------------
# Vercel AI Gateway (https://vercel.com/docs/ai-sdk/gateway)
# Seamless infra: set this to route all AI through Vercel's managed gateway
# (higher TPM, unified retries/billing) with automatic fallback to direct Groq.
# Get a key at https://vercel.com/dashboard -> AI Gateway.
# When set, TOTAL_BUDGET auto-raises 4200→7000; override with AI_BUDGET_TOKENS.
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
# Optional: override per-request token budget (1000-12000). Default 4200 direct, 7000 gateway.
# AI_BUDGET_TOKENS=4200

# -----------------------------------------------------------------------------
# Desmos Graphing Calculator API key
# Get a key at https://www.desmos.com/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DESMOS_API_KEY=YOUR-DESMOS-API-KEY

# -----------------------------------------------------------------------------
# Site URL - used by Next.js for absolute URLs in server components, and by
# auth redirects so OAuth/email callbacks always land on the canonical domain
# (never a Vercel deployment alias like analogix-analogix.vercel.app).
# In local dev: http://localhost:3000
# In production: https://analogix.vercel.app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE-WITH-SECRET

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) - path to the MCP server script.
# Only needed if you're running AI tool execution locally.
# -----------------------------------------------------------------------------
MCP_SERVER_PATH=vendor/analogix-mcp/dist/index.js
